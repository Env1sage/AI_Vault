# Copy to .env and fill in real values for local development. Never commit
# `.env` itself (see .gitignore) — this file only documents what's required,
# per Engineering Handbook §13 (Secure secrets management).
#
# Consumed by apps/backend and apps/worker via vault_shared.settings.Settings
# (packages/shared/vault_shared/settings.py) and docker-compose's env_file.
# apps/frontend has its own .env.example (Vite only loads VITE_-prefixed vars).

SERVICE_NAME=vault-backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches docker-compose.yml's postgres/redis service names when run via
# `docker compose up`; use localhost equivalents when running apps directly
# on the host instead of in containers.
DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5432/vault
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# Phase 2 — Identity & Organization Platform. Never a real secret in this file.
JWT_SECRET=changeme-use-a-real-random-32-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=vault_refresh_token
# Set to true in any environment served over HTTPS.
COOKIE_SECURE=false

# Google Identity Services (client-side "Sign in with Google" — see
# apps/frontend/.env.example's VITE_GOOGLE_CLIENT_ID, same value).
# Create a project at https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
