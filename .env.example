# Copy to .env and fill in real values for local development. Never commit
# `.env` itself (see .gitignore) — this file only documents what's required,
# per Engineering Handbook §13 (Secure secrets management).
#
# Consumed by apps/backend and apps/worker via vault_shared.settings.Settings
# (packages/shared/vault_shared/settings.py) and docker-compose's env_file.
# apps/frontend has its own .env.example (Vite only loads VITE_-prefixed vars).

SERVICE_NAME=vault-backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches docker-compose.yml's postgres/redis service names when run via
# `docker compose up`; use localhost equivalents when running apps directly
# on the host instead of in containers.
DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5432/vault
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# Phase 2 — Identity & Organization Platform. Never a real secret in this file.
JWT_SECRET=changeme-use-a-real-random-32-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=vault_refresh_token
# Set to true in any environment served over HTTPS.
COOKIE_SECURE=false

# Google Identity Services (client-side "Sign in with Google" — see
# apps/frontend/.env.example's VITE_GOOGLE_CLIENT_ID, same value).
# Create a project at https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 3 — Google Workspace Connector Platform (ADR-014). Uses the same
# Google Cloud OAuth client as above, but a separate server-side flow —
# add GOOGLE_WORKSPACE_REDIRECT_URI as an authorized redirect URI on that
# same OAuth client in the Google Cloud Console.
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:5173/connectors/google/callback
# Bumped from drive.readonly to full drive scope in Phase 8 (ADR-020) — the
# Execution Engine needs write access. A connector authorized before Phase 8
# only granted drive.readonly and must be reconnected to pick up write access.
GOOGLE_WORKSPACE_SCOPES=openid email profile https://www.googleapis.com/auth/drive
OAUTH_STATE_TTL_SECONDS=600
# Fernet key for encrypting connector OAuth tokens at rest. The value below
# is a real, working key generated for local development ONLY — regenerate
# with `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# for any environment that isn't your own machine.
CONNECTOR_ENCRYPTION_KEY=kdvNPNW1oDBDWzrUqgYhZI414BBDPQfomFczRORzD8Y=

# Phase 2 (AI File Intelligence). Leave COMPLETION_PROVIDER=extractive and
# COMPLETION_API_KEY empty to keep today's deterministic stub everywhere
# AIGateway.complete() is used (RAG chat included) — the real provider only
# activates once BOTH are set. Get a key from platform.moonshot.ai (or swap
# COMPLETION_API_BASE_URL/COMPLETION_MODEL_NAME for any other OpenAI-
# compatible provider, e.g. GLM's open.bigmodel.cn).
COMPLETION_PROVIDER=extractive
COMPLETION_API_BASE_URL=https://api.moonshot.ai/v1
COMPLETION_API_KEY=
COMPLETION_MODEL_NAME=kimi-k2-0711-preview
COMPLETION_REQUEST_TIMEOUT_SECONDS=60

# AI Storage Assistant (ADR-024) — extends "Ask Vault" (ConversationService)
# with tools over Storage Intelligence data. To use OpenRouter + GLM instead
# of the Kimi default above, reuse the SAME four COMPLETION_* vars — do not
# add separate AI_PROVIDER/AI_MODEL/OPENROUTER_API_KEY vars, OpenRouter is
# just another OpenAI-compatible endpoint:
#   COMPLETION_PROVIDER=openai_compatible
#   COMPLETION_API_BASE_URL=https://openrouter.ai/api/v1
#   COMPLETION_API_KEY=<your OpenRouter key>
#   COMPLETION_MODEL_NAME=<the exact GLM model slug from openrouter.ai's model page>
# The exact OpenRouter slug for "GLM 5.2" isn't hardcoded here since it must
# be copied from OpenRouter's own model catalog, not guessed.
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_TOOL_CALLS=3
AI_MAX_CONTEXT_ITEMS=10
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_SEARCH_RESULTS=10
AI_TOOL_CACHE_TTL_SECONDS=60
AI_TOOL_RATE_LIMIT_PER_MINUTE=10
AI_MAX_LARGE_FILE_THRESHOLD_BYTES=5497558138880
AI_MAX_AGE_DAYS=3650

# Phase 8 — Execution Engine (ADR-020). Defaults are sane for local dev;
# override per-environment if needed.
EXECUTION_MAX_RETRIES=3
EXECUTION_TIMEOUT_SECONDS=300
APPROVAL_EXPIRY_HOURS=72
EXECUTION_ROLLBACK_ENABLED=true

# Phase 9 — Automation Engine (ADR-021). SCHEDULER_TIMEZONE is the IANA
# zone `SCHEDULED` workflow triggers' cron expressions are interpreted in
# (e.g. "0 2 * * *" means 2am there, not always UTC) — independent of
# Celery's own broker timezone, which stays UTC. NOTIFICATION_EMAIL_ENABLED
# is a placeholder toggle only — email delivery is a stub this phase
# regardless (the founder's binding choice; no real provider configured),
# so flipping this does not cause any real email to be sent.
WORKFLOW_MAX_RETRIES=3
WORKFLOW_TIMEOUT_SECONDS=300
SCHEDULER_TIMEZONE=UTC
NOTIFICATION_EMAIL_ENABLED=false
DEFAULT_APPROVAL_TIMEOUT_HOURS=72

# Phase 10 — Production Hardening (ADR-022). How long `/v1/dashboard`'s
# response is cached per-organization in Redis before recomputing —
# staleness window, not a correctness knob (the underlying data only
# actually changes once per scan/enrichment/embedding/recommendation
# cycle anyway). SENTRY_DSN/OTEL_EXPORTER_OTLP_ENDPOINT are read directly
# from the environment, not through Settings — both are no-ops (stubbed
# off) when unset, see vault_shared/error_tracking.py and tracing.py.
DASHBOARD_CACHE_TTL_SECONDS=30
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Archive MVP — object storage for compressed archive packages
# (ObjectStorageClient). Matches docker-compose.yml's local `minio` service;
# a real deployment points these at an actual S3 bucket/credentials
# instead, sharing the same client code (boto3, S3-compatible).
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=vault-minio
OBJECT_STORAGE_SECRET_KEY=vault-minio-secret
OBJECT_STORAGE_BUCKET=vault-archives
OBJECT_STORAGE_SECURE=false
# Caps per-file memory while building an archive zip — GoogleDriveClient's
# download/export methods return full bytes in memory, no streaming today.
ARCHIVE_MAX_FILE_SIZE_BYTES=209715200

# Worker-only observability (Phase 10, ADR-022) — see
# apps/worker/worker/metrics_server.py's docstring. Both must match what
# infrastructure/docker/docker-compose.monitoring.yml sets if you're
# running the optional local monitoring stack.
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir
METRICS_PORT=9101
