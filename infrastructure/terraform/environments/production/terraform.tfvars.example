# Copy to terraform.tfvars and fill in real values — never commit the
# real file (it contains secrets). CI's `deploy` job instead sets these
# via TF_VAR_* environment variables sourced from GitHub Environment
# secrets (see .github/workflows/ci.yml's `deploy` job) — this file is
# for a human running `terraform plan`/`apply` by hand.

aws_region         = "us-east-1"
availability_zones = ["us-east-1a", "us-east-1b"]

container_registry = "123456789012.dkr.ecr.us-east-1.amazonaws.com"
backend_image_tag   = "replace-with-a-real-git-sha"
worker_image_tag    = "replace-with-a-real-git-sha"
frontend_image_tag  = "replace-with-a-real-git-sha"

database_master_password = "replace-me" # pragma: allowlist secret
jwt_secret                = "replace-me-32-bytes-minimum"
connector_encryption_key  = "replace-me-fernet-key"
google_client_id          = "replace-me.apps.googleusercontent.com"
google_client_secret      = "replace-me"
sentry_dsn                 = "" # empty = Sentry stays off (vault_shared/error_tracking.py)

acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"
pager_email          = "oncall@example.com"
